<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <parent>
    <artifactId>pom-scijava</artifactId>
    <groupId>org.scijava</groupId>
    <version>37.0.0</version>
    <relativePath>pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ds4h.scratchradiomics</groupId>
  <artifactId>ScratchRadiomics</artifactId>
  <name>ScratchRadiomics</name>
  <version>1.0</version>
  <description>Fiji plugin for quantitative analysis of Wound Healing Scratch Assay images.
        Supports manual ROI drawing, automatic segmentation via micro-SAM (SAM2),
        and extraction of radiomic features including morphology, intensity, GLCM texture,
        and temporal closure metrics on time-lapse stacks.</description>
  <url>https://github.com/LorenzoRigoni/ScratchRadiomics.git</url>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/imagej/example-legacy-plugin/issues</url>
  </issueManagement>
  <ciManagement>
    <system>None</system>
  </ciManagement>
  <inceptionYear>2026</inceptionYear>
  <mailingLists>
    <mailingList>
      <name>Image.sc Forum</name>
      <archive>https://forum.image.sc/tag/imagej</archive>
    </mailingList>
  </mailingLists>
  <developers>
    <developer>
      <id>LorenzoRigoni</id>
      <name>Lorenzo Rigoni</name>
      <email>lorenzo.rigoni2@studio.unibo.it</email>
      <organization>Alma Mater Studiorum - Università di Bologna</organization>
      <roles>
        <role>lead</role>
        <role>developer</role>
        <role>debugger</role>
        <role>reviewer</role>
        <role>support</role>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>
  <contributors>
    <contributor>
      <name>none</name>
    </contributor>
  </contributors>
  <licenses>
    <license>
      <name>GNU General Public License v3+</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/imagej/example-legacy-plugin</connection>
    <developerConnection>scm:git:git@github.com:imagej/example-legacy-plugin</developerConnection>
    <url>https://github.com/imagej/example-legacy-plugin</url>
  </scm>
  <organization>
    <name>UNIBO Data Science For Health</name>
    <url>https://github.com/UniBoDS4H/</url>
  </organization>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer />
                <transformer>
                  <mainClass>it.scratchradiomics.plugin.ScratchRadiomicsPlugin</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public/</url>
    </pluginRepository>
  </pluginRepositories>
  <dependencies>
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>imagej-legacy</artifactId>
      <version>1.2.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.scijava</groupId>
      <artifactId>scijava-common</artifactId>
      <version>2.97.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>hamcrest-core</artifactId>
          <groupId>org.hamcrest</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <license.copyrightOwners>UNIBO Data Science For Health (DS4H).</license.copyrightOwners>
    <onnxruntime.version>1.17.1</onnxruntime.version>
    <maven.compiler.target>11</maven.compiler.target>
    <maven.compiler.source>11</maven.compiler.source>
    <poi.version>5.2.5</poi.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <license.licenseName>GPL 3.0, CC0</license.licenseName>
  </properties>
</project>
